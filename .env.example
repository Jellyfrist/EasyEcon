# Copy this file to .env and fill in your real values

# Flask/FastAPI Config
FLASK_DEBUG=1
APP_ENV=production
SECRET_KEY="YOUR_SECRET_KEY_HERE"
JWT_SECRET_KEY="YOUR_JWT_SECRET_KEY_HERE"

# Database use Supabase
SUPABASE_PORT=6543
SUPABASE_DB_URL="YOUR_SUPABASE_DB_URL_HERE"

# Google OAuth
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE"
GOOGLE_CLIENT_SECRET="YOUR_GOOGLE_CLIENT_SECRET_HERE"
GOOGLE_DISCOVERY_URL=https://accounts.google.com/.well-known/openid-configuration
GOOGLE_REDIRECT_URI="YOUR_GOOGLE_REDIRECT_URI_HERE"

# GitHub OAuth
GITHUB_CLIENT_ID="YOUR_GITHUB_CLIENT_ID_HERE"
GITHUB_CLIENT_SECRET="YOUR_GITHUB_CLIENT_SECRET_HERE"
GITHUB_REDIRECT_URI="YOUR_GITHUB_REDIRECT_URI_HERE"

# URLs
BACKEND_URL=http://localhost:56733

FRONTEND_URL=http://localhost:8080
FRONTEND_LOGIN_SUCCESS_URI=http://localhost:8080/dashboard
FRONTEND_LOGIN_FAILURE_URI=http://localhost:8080/login

VITE_API_BASE_URL=http://localhost:56733/auth